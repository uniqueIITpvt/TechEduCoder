NODE_ENV=development
PORT=8000

# Comma-separated frontend origins are supported
ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Payment fulfillment uses transactions, so MongoDB must be a replica set or mongos.
DB_URL=mongodb://127.0.0.1:27017/techeducoder?replicaSet=rs0
REDIS_URL=
REDIS_DISABLED=true

ACCESS_TOKEN=replace-with-a-long-random-secret
REFRESH_TOKEN=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE=5
REFRESH_TOKEN_EXPIRE=3

SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=

CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_SECRET_KEY=

KEY_ID=
KEY_SECRET=
# Set this to the secret configured for /api/v1/payment/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=
VDOCIPHER_API_SECRET=

# Optional Sentry transaction sampling rate (0 to 1)
SENTRY_TRACES_SAMPLE_RATE=0.1
