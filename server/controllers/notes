    export const updateCourseEvent = CatchAsyncError(async (req:Request, res:Response, next:NextFunction) => {
      try {
        // Assuming the ID of the CourseEvent to update is passed in the URL as a parameter
        const courseEventId = req.params.id;
        const { eventsType, eventPercentage, eventsName, filteredCourseId, startDate, endDate } = req.body;
    
        // Find the existing CourseEvent by ID
        const existingCourseEvent = await CourseEvent.findById(courseEventId);
        if (!existingCourseEvent) {
          return next(new ErrorHandler("Course event id not found", 400));
        }
    
        // Store the original course IDs before the update
        const originalCourseIds = existingCourseEvent.filteredCourseId.map(course => course.toString());
    
       
        // Find courses that are no longer part of the event
        const coursesToRemove = originalCourseIds.filter(courseId => !filteredCourseId.includes(courseId));
    
        // Set isEvent to false for removed courses
        await Promise.all(
          coursesToRemove.map(courseId =>
            CourseModel.findByIdAndUpdate(courseId, { $set: { isEvent: false } }, { new: true })
          )
        );
    
        // Update the courses that are still part of the event
        const updatedCourses = await Promise.all(
          filteredCourseId.map(async ({courseId}) => {
            const course = await CourseModel.findById(courseId);
            if (!course) {
              throw new Error(`Course with ID ${courseId} not found`);
            }
            
            const originalPrice = course.originalPrice || course.discountPrice / (1 - existingCourseEvent.eventPercentage / 100);
            const newPrice = originalPrice * (1 - eventPercentage / 100);
    
            // Update the course with the new price and set isEvent to true
            return CourseModel.findByIdAndUpdate(
              courseId,
              { $set: { discountPrice: newPrice, isEvent: true } },
              { new: true }
            );
          })
        );
    
        // Update the CourseEvent itself with the new information
        const updatedCourseEvent = await CourseEvent.findByIdAndUpdate(
          courseEventId,
          {
            $set: {
              eventsType,
              eventPercentage,
              eventsName,
              filteredCourseId,
              startDate,
              endDate
            },
          },
          { new: true }
        );
    
        // Return the updated CourseEvent
        res.status(200).json({
          success: true,
          message: 'CourseEvent updated successfully',
          data: updatedCourseEvent,
          updatedCourses: updatedCourses
        });
      } catch (error:any) {
        return next(new ErrorHandler(error.message, 400));
      }
    });


    // Yeh aapka original courses array of objects hai
const originalCourses = [
  {
    courseId: '6604f92579b76f0f51f76a41',
    _id: new ObjectId("66099a1aef079cbb08501eae")
  },
  {
    courseId: '660271b00ccaaa21dcdfb580',
    _id: new ObjectId("66099a1aef079cbb08501eaf")
  }
];

// Yeh filteredCourseIds hai jismein objects hain
const filteredCourseIds = [
  { courseId: '660271b00ccaaa21dcdfb580' }
];

// filteredCourseIds array se sirf courseId values extract karen
const filteredIds = filteredCourseIds.map(course => course.courseId);

// originalCourses se un courses ko find karen jo filtered list mein nahi hain
const coursesToRemove = originalCourses.filter(course => !filteredIds.includes(course.courseId));

console.log("Courses to Remove:", coursesToRemove);

  