{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "env": {
    "ORIGIN": "https://techeducoderlms.vercel.app,https://techeducoderlms-unique-iits-projects.vercel.app,https://techeducoderlms-git-main-unique-iits-projects.vercel.app",
    "CLIENT_URL": "https://techeducoderlms.vercel.app,https://techeducoderlms-unique-iits-projects.vercel.app,https://techeducoderlms-git-main-unique-iits-projects.vercel.app",
    "REDIS_DISABLED": "true"
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["mails/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
