# Copy this file to .env.local for local development.
# Production values should be configured in the deploy provider.

# Public browser configuration
NEXT_PUBLIC_SERVER_URI=http://localhost:8000/api/v1/
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_TINY_API_KEY=

# NextAuth server-side configuration
NEXTAUTH_URL=http://localhost:3000
SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: enables Sentry source-map upload during a production build
SENTRY_AUTH_TOKEN=
